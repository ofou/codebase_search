{
  "mcpServers": {
    "codebase-search": {
      "command": "python3",
      "args": [
        "/app/mcp_codebase_server.py"
      ],
      "description": "Semantic codebase search using embeddings with file watching and background indexing",
      "enabled": true,
      "transport": "sse",
      "port": 8086,
      "tools": {
        "codebase_search": {
          "description": "Find code snippets by semantic meaning",
          "input_schema": {
            "type": "object",
            "properties": {
              "query": {
                "title": "Query",
                "type": "string",
                "description": "The query to search for in the codebase."
              },
              "target_directories": {
                "anyOf": [
                  {
                    "items": {
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Target Directories",
                "description": "The directories to search in. If null, all directories are searched."
              },
              "explanation": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Explanation",
                "description": "The explanation of the search query. If null, no explanation is provided."
              }
            },
            "required": [
              "query"
            ],
            "title": "codebase_searchArguments"
          }
        },
        "get_index_status": {
          "description": "Get the current status of the file index",
          "input_schema": {
            "type": "object",
            "properties": {},
            "required": [],
            "title": "get_index_statusArguments"
          }
        }
      },
      "timeout": 1800,
      "disabled": false
    }
  }
}
